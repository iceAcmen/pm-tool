# 依赖与构建产物
node_modules/
dist/
build/
out/
*.tsbuildinfo

# 日志与临时文件
*.log
logs/
tmp/
.tmp/

# 环境变量与密钥（严禁提交）
.env
.env.*
!.env.example
*.key
*.pem

# 系统/编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# dsh 本地运行数据（按需）
.dsh/

# PM 业务数据目录（项目/任务/里程碑的 JSON 与渲染的 Markdown）
# 阶段 2 决策（ADL-009）：真实业务数据暂不纳入 git；目录由存储后端在首次写入时自动创建
data/

# R4 默认导出目录（可重新生成，不作为数据源）
exports/
backups/
