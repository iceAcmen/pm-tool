# 依赖与构建产物
node_modules/
dist/
build/
out/
coverage/
*.tsbuildinfo

# 日志与临时文件
*.log
logs/
tmp/
.tmp/
# 子代理产出目录（决定性截图证据复制到 docs/verification/ 后入库）
artifacts/
**/artifacts/

# 环境变量与密钥（严禁提交）
.env
.env.*
!.env.example
*.key
*.pem

# 系统/编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# dsh 本地运行数据（按需）
.dsh/

# PM 业务数据目录（项目/任务/里程碑的 JSON 与渲染的 Markdown）
# 阶段 2 决策（ADL-009）：真实业务数据暂不纳入 git；目录由存储后端在首次写入时自动创建
data/
# 例外：vendor 第三方 skill 自带的知识库 data 目录属于 skill 内容（非运行时数据），需逐字节入库
!vendor/agent-skills/**/data/
!vendor/agent-skills/**/data/**

# R4 默认导出目录（可重新生成，不作为数据源）
exports/
backups/

# 回归验证运行产物（agent 并行回归临时目录与 tar.gz 归档）
# 见 docs/testing/test-plan.md：verify-run-*/ 为回归 agent 并行产物；
# 决定性结论已摘要入 docs/testing 与 docs/verification，原始运行目录/归档不入库、不删除（本地留存证据）。
verify-run-*/
verify-run-*.tar.gz
