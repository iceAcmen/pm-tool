    "executed": false,
    "sourceText": "import { connect, clickText } from '/private/tmp/pmtool-gui-lib-20261021.mjs'\nimport { mkdirSync, writeFileSync, readdirSync, readFileSync, statSync } from 'node:fs'\nimport { createHash } from 'node:crypto'\nconst { browser, page } = await connect()\nconst out = '/Users/bytedance/Projects/dsh-pm/pm-tool/reports/all-pending-evidence-20261021/A5/board'\nconst records = []\nconst cdp = await page.createCDPSession()\nfunction manifest() {\n  const root = '/private/tmp/pmtool-closure-runtime-20261021/data'\n  const result = {}\n  function walk(dir) {\n    for (const n of readdirSync(dir)) {\n      const p = `${dir}/${n}`\n      if (statSync(p).isDirectory()) walk(p)\n      else result[p.slice(root.length)] = createHash('sha256').update(readFileSync(p)).digest('hex')\n    }\n  }\n  walk(root); return result\n}\nconst before = manifest()\nasync function capture(label, pointer) {\n  const current = await page.evaluate(() => {\n    const stage = document.querySelector('.pm-bento-stage')\n    const grid = document.querySelector('.pm-rgl')\n    const shell = document.querySelector('.pm-shell')\n    const cards = [...document.querySelectorAll('[data-widget-id]')].map(n => ({\n      id: n.dataset.widgetId, bbox: n.getBoundingClientRect().toJSON(), transform: getComputedStyle(n).transform,\n    }))\n    return {\n      at: new Date().toISOString(), viewport: { width: innerWidth, height: innerHeight },\n      cards, placeholder: document.querySelector('.react-grid-placeholder')?.getBoundingClientRect().toJSON(),\n      stage: { bbox: stage.getBoundingClientRect().toJSON(), scrollHeight: stage.scrollHeight, clientHeight: stage.clientHeight, scrollTop: stage.scrollTop },\n      grid: { bbox: grid.getBoundingClientRect().toJSON(), scrollHeight: grid.scrollHeight },\n      shell: { scrollTop: shell.scrollTop, scrollHeight: shell.scrollHeight, scrollWidth: shell.scrollWidth, clientWidth: shell.clientWidth },\n      undo: [...document.querySelectorAll('button')].find(n => n.innerText === '↶ 撤销')?.disabled,\n    }\n  })\n  records.push({ label, pointer, current })\n  writeFileSync(`${out}/original-drag-states.json`, JSON.stringify(records, null, 2))\n  await page.screenshot({ path: `${out}/original-${label}.png` })\n}\nasync function drag(id, destinationRow, label) {\n  const h = await page.$(`[data-widget-id=\"${id}\"]`)\n  await h.scrollIntoView()\n  const box = await h.boundingBox()\n  const start = { x: box.x + 100, y: Math.max(35, box.y + 22) }\n  await page.mouse.move(start.x, start.y)\n  await page.mouse.down()\n  const top = await page.$eval('.pm-rgl', n => n.getBoundingClientRect().top)\n  const destination = { x: start.x, y: top + 12 + destinationRow * 48 + 22 }\n  if (destination.y < 20 || destination.y > 875) throw new Error(`destination out of viewport ${destination.y}`)\n  await page.mouse.move(destination.x, destination.y, { steps: 30 })\n  await capture(`${label}-drop`, { start, destination, buttons: 1, targetRow: destinationRow })\n  await page.mouse.up()\n  await page.waitForFunction(() => !document.querySelector('.react-draggable-dragging'))\n  await new Promise(resolve => setTimeout(resolve, 270))\n  await capture(label, { start, destination, buttons: 0, targetRow: destinationRow })\n}\ntry {\n  await page.bringToFront()\n  await capture('drag0')\n  await drag('w-hero', 12, 'drag1')\n  await drag('w-ms-deliver', 4, 'drag2')\n  await drag('w-hero', 0, 'drag3')\n  // 工具条滚回视口再点，三次撤销不插任何其他布局动作。\n  for (let i = 1; i <= 3; i++) {\n    const undo = await page.evaluateHandle(() => [...document.querySelectorAll('button')].find(n => n.innerText === '↶ 撤销'))\n    await undo.asElement().scrollIntoView()\n    await undo.asElement().click()\n    await new Promise(resolve => setTimeout(resolve, 270))\n    await capture(`undo${i}`)\n  }\n  writeFileSync(`${out}/original-drag-boundary.json`, JSON.stringify({ before, after: manifest(), boundary: 'three original pointer targets then three undo; no save/domain writes; final canonical still needs export' }, null, 2))\n  console.log({ states: records.length, last: records.at(-1).label })\n} finally { browser.disconnect() }\n",
    "secondDragGuardBeforeMove": true,
    "interruptedBoundaryExists": false
  },
