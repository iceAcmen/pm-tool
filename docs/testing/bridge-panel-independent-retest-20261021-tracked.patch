+  /** 每次工作台数据成功就绪时调用；失败可重试，每个令牌成功后幂等。 */
   reportReady: () => Promise<boolean>
 }
 
 /**
  * 工作台就绪回告门：首次快照/网络失败不永久丢失 S4，后续成功刷新会继续尝试；
