+    callbacks: f.callbacks, onCancel: noop }))
+  const rows = renderer.root.findAllByProps({ className: 'rb-action-row' })
+  await change(rows[0], '行动项标题', '主保存一')
+  await change(rows[1], '行动项标题', '主保存二')
+  await act(async () => rows[1].findByType(RecordsListbox).props.onChange('done'))
+  await submit(renderer)
+  const saved = getMeeting(f.domain, f.meeting.id)!
+  expect(saved.actions).toEqual([
+    { ...f.meeting.actions[0], title: '主保存一' },
+    { ...f.meeting.actions[1], title: '主保存二', status: 'done' },
+  ])
+  expect(saved.createdAt).toBe(f.meeting.createdAt)
+  expect(saved.sourceType).toBe(f.meeting.sourceType)
+  expect(saved.sourceSessionId).toBe(f.meeting.sourceSessionId)
+  expect(f.onSaved).toHaveBeenCalledTimes(1)
+  expect(JSON.parse(f.lines[0].slice(`meeting update ${f.meeting.id} `.length))).not.toHaveProperty('actions')
+})
