+import type { PmDomain } from '../../../core/storage.js'
+
+const noop = () => {}
+const mounts: ReactTestRenderer[] = []
+const text = (node: ReactTestInstance): string => node.children.map(child =>
+  typeof child === 'string' ? child : text(child)).join('')
+function mount(element: ReturnType<typeof createElement>) {
+  let renderer!: ReactTestRenderer
+  act(() => { renderer = create(element) })
+  mounts.push(renderer)
+  return renderer
+}
+function button(root: ReactTestInstance, label: string) {
+  const result = root.findAllByType('button').find(node => text(node) === label)
+  expect(result, label).toBeTruthy()
+  return result!
+}
+async function change(root: ReactTestInstance, label: string, value: string) {
+  await act(async () => root.findByProps({ 'aria-label': label }).props.onChange({ currentTarget: { value } }))
+}
+async function submit(renderer: ReactTestRenderer) {
+  await act(async () => renderer.root.findByType('form').props.onSubmit({ preventDefault: noop }))
+}
+function memoryDomain(): PmDomain {
+  const tables = new Map<string, Map<string, unknown>>()
+  return { table(name: string) {
+    if (!tables.has(name)) tables.set(name, new Map())
+    const table = tables.get(name)!
+    return { get: (id: string) => table.get(id), put: (id: string, value: unknown) => table.set(id, value),
+      entries: () => table.entries(), keys: () => table.keys(), list: () => [...table.values()],
+      delete: (id: string) => table.delete(id) }
+  } } as unknown as PmDomain
+}
+async function fixture() {
+  const domain = memoryDomain()
+  const project = await addProject(domain, { name: 'A9 A', startDate: '2026-10-21', targetDate: '2026-12-31' })
+  const other = await addProject(domain, { name: 'A9 B', startDate: '2026-10-21', targetDate: '2026-12-31' })
+  const task = await addTask(domain, { projectId: project.id, title: '同项目任务' })
+  const otherTask = await addTask(domain, { projectId: other.id, title: '跨项目任务' })
+  const issue = await addRiskIssue(domain, { projectId: project.id, type: 'issue', title: '同项目问题', impact: 'low' })
+  const risk = await addRiskIssue(domain, { projectId: project.id, type: 'risk', title: '同项目风险', impact: 'low', probability: 'low' })
+  const otherIssue = await addRiskIssue(domain, { projectId: other.id, type: 'issue', title: '跨项目问题', impact: 'low' })
+  const meeting = await addMeeting(domain, { projectId: project.id, title: 'A9 会议', meetingDate: '2026-10-21' })
+  await addMeetingAction(domain, meeting.id, { title: '原行动一', taskId: task.id, riskIssueId: issue.id })
+  await addMeetingAction(domain, meeting.id, { title: '原行动二', status: 'in_progress' })
+  const lines: string[] = []
+  const onSaved = vi.fn()
+  const callbacks = createMeetingCallbacks({ projectId: project.id, refresh: noop, confirm: async () => true,
+    run: async line => {
+      lines.push(line)
+      return (await handleMeetingCommand(line.slice('meeting '.length), domain)).kind === 'success'
+    } })
+  callbacks.onSaved = onSaved
+  return { domain, project, task, otherTask, issue, risk, otherIssue, meeting: getMeeting(domain, meeting.id)!,
+    callbacks, lines, onSaved }
+}
+beforeEach(() => {
+  vi.stubGlobal('window', { addEventListener: noop, removeEventListener: noop })
+  vi.stubGlobal('document', { activeElement: null, addEventListener: noop, removeEventListener: noop,
+    querySelector: () => null, body: { dataset: {} } })
+  vi.stubGlobal('HTMLElement', class {})
+  vi.stubGlobal('requestAnimationFrame', (callback: () => void) => { callback(); return 1 })
+  vi.stubGlobal('cancelAnimationFrame', noop)
+})
+afterEach(() => {
+  for (const renderer of mounts.splice(0)) act(() => renderer.unmount())
+  vi.unstubAllGlobals()
+})
