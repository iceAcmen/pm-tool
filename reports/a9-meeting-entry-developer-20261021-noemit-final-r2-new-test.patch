+it('LG-01b 新行部分成功后失败保输入，重试不重复 add 且只在全部成功后关闭', async () => {
+  const f = await fixture()
+  const emptyMeeting = await addMeeting(f.domain, { projectId: f.project.id, title: '空行动会议', meetingDate: '2026-10-21' })
+  let fail = true
+  const original = f.callbacks.onSaveAction
+  f.callbacks.onSaveAction = async (meetingId, actionId, payload) => {
+    if (fail && payload.title === '第二新行') return false
+    return original(meetingId, actionId, payload)
+  }
+  const renderer = mount(createElement(RecordsMeetingForm, { projectId: f.project.id, meeting: emptyMeeting,
+    callbacks: f.callbacks, onCancel: noop }))
+  for (const title of ['第一新行', '第二新行']) {
+    await act(async () => button(renderer.root, '添加行动项').props.onClick())
+    await change(renderer.root.findAllByProps({ className: 'rb-action-row' }).at(-1)!, '行动项标题', title)
+  }
+  await submit(renderer)
+  expect(f.onSaved).not.toHaveBeenCalled()
+  expect(getMeeting(f.domain, emptyMeeting.id)!.actions.map(action => action.title)).toEqual(['第一新行'])
+  const rows = renderer.root.findAllByProps({ className: 'rb-action-row' })
